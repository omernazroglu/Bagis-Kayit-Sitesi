@model List<Bagisci>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grup Listesi</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg: #f1f5f9;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --accent: #10b981;
        }

        body { 
            background-color: var(--bg); 
            font-family: 'Inter', sans-serif; 
            margin: 0;
            padding: 20px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 20px;
            color: var(--text-main);
        }

        .search-box {
            max-width: 400px;
            margin: 0 auto 30px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 0.95rem;
        }

        .groups-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .group-card {
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 6px 12px rgba(0,0,0,0.1);
            border: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .group-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }

        .group-header {
            color: white;
            padding: 16px;
            text-align: center;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
        }

        .card-body {
            padding: 8px 0;
            display: block; /* artık tüm kartlar açık */
        }

        .member-row {
            padding: 12px 20px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .member-row:last-child {
            border-bottom: none;
        }

        .member-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .number {
            font-weight: 700;
            color: var(--accent);
            width: 24px;
            text-align: center;
        }

        .name {
            font-weight: 600;
            color: var(--text-main);
            font-size: 0.95rem;
        }

        .phone {
            color: var(--text-muted);
            font-size: 0.85rem;
            background: #f8fafc;
            padding: 2px 8px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
        }

        @@media (max-width: 1024px) { .groups-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 650px) { .groups-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

    <header class="page-header">
        <h1>Bağışçı Grupları</h1>
    </header>

    <div class="search-box">
        <input type="text" id="searchInput" placeholder="İsim veya telefon ara..." />
    </div>

    <div class="groups-grid" id="groupsGrid">
        @{
            var gruplar = Model.GroupBy(x => x.GrupNo).OrderBy(g => g.Key);
            string[] renkler = new string[] { "#2563eb", "#ef4444", "#f59e0b", "#10b981", "#8b5cf6", "#ec4899", "#3b82f6" };
        }

        @foreach (var grup in gruplar)
        {
            var renk = renkler[(int)grup.Key % renkler.Length];
            <div class="group-card">
                <div class="group-header" style="background-color:@renk">
                    GRUP @grup.Key
                </div>
                <div class="card-body">
                    @{
                        var isimler = grup.Where(x => !string.IsNullOrWhiteSpace(x.AdSoyad)).ToList();
                        var telefonlar = grup.Where(x => !string.IsNullOrWhiteSpace(x.Telefon)).ToList();

                        for (int i = 0; i < isimler.Count; i++)
                        {
                            <div class="member-row">
                                <div class="member-info">
                                    <span class="number">@(i+1)</span>
                                    <span class="name">@isimler[i].AdSoyad</span>
                                </div>
                                <span class="phone">
                                    @(i < telefonlar.Count ? telefonlar[i].Telefon : "Telefon Yok")
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('input', () => {
            const query = searchInput.value.toLowerCase();

            document.querySelectorAll('.group-card').forEach(card => {
                let hasMatch = false;

                // Önce tüm üyeleri kontrol et
                card.querySelectorAll('.member-row').forEach(row => {
                    const name = row.querySelector('.name').textContent.toLowerCase();
                    const phone = row.querySelector('.phone').textContent.toLowerCase();

                    if (name.includes(query) || phone.includes(query)) {
                        hasMatch = true;
                    }
                });

                // Eğer grup içinde eşleşme varsa, tüm üyeleri göster, yoksa grubu gizle
                if (hasMatch) {
                    card.style.display = 'flex';
                    card.querySelectorAll('.member-row').forEach(row => {
                        row.style.display = 'flex';
                    });
                } else {
                    card.style.display = 'none';
                }
            });
        });
    </script>

</body>
</html>